{
  "name": "orbit",
  "productName": "Orbit",
  "version": "0.0.0",
  "description": "Your day, plans, money, reading and dreams in one place.",
  "author": "Ahmed Walid",
  "homepage": "https://github.com/AhmedWalid4499/Orbit",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "electron-winstaller": false,
    "fsevents": false
  },
  "build": {
    "appId": "com.personal.orbit",
    "productName": "Orbit",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Support/Supabase.json",
        "to": "Supabase.json"
      }
    ],
    "protocols": [
      {
        "name": "Orbit",
        "schemes": [
          "com.personal.orbit"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Orbit-Setup.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Orbit",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AhmedWalid4499",
        "repo": "Orbit",
        "releaseType": "release"
      }
    ]
  }
}
